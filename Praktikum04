        "### K-1 (lanjutan) — Membaca `trips_bersih/` dan Mengganti Nama Kolom\n",
        "\n",
        "Nama kolom asli data TLC diganti menjadi nama yang mudah dibaca (`waktu_jemput`, `zona_jemput`,\n",
        "dan seterusnya) agar seluruh kode di praktikum ini konsisten dan mudah dibaca, mengikuti kamus nama\n",
        "kolom pada Bagian I modul."
      ],
      "metadata": {
        "id": "KTZaMb-RBN5M"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pyarrow as pa\n",
        "import pyarrow.parquet as pq\n",
        "\n",
        "def muat_tanpa_kamus(path_data):\n",
        "    # Muat tabel secara utuh\n",
        "    tabel = pq.read_table(path_data)\n",
        "    skema = tabel.schema\n",
        "    kolom_baru = {}\n",
        "\n",
        "    # Deteksi dan hapus representasi dictionary pada kolom\n",
        "    for i, field in enumerate(skema):\n",
        "        if pa.types.is_dictionary(field.type):\n",
        "            # Cast kolom dictionary ke tipe data nilai aslinya\n",
        "            kolom_baru[field.name] = tabel.column(field.name).cast(field.type.value_type)\n",
        "\n",
        "    if kolom_baru:\n",
        "        for nama, kol in kolom_baru.items():\n",
        "            idx = skema.get_field_index(nama)\n",
        "            tabel = tabel.set_column(idx, nama, kol)\n",
        "\n",
        "    return tabel.to_pandas()\n",
        "\n",
        "df = ukur(\"baca trips_bersih\", lambda: muat_tanpa_kamus(TRIPS_BERSIH))\n",
        "\n",
        "NAMA_BARU = {\n",
        "    \"tpep_pickup_datetime\": \"waktu_jemput\",\n",
        "    \"PULocationID\": \"zona_jemput\",\n",
        "    \"DOLocationID\": \"zona_tujuan\",\n",
        "    \"borough_naik\": \"wilayah_jemput\",\n",
        "    \"trip_distance\": \"jarak_mil\",\n",
        "    \"total_amount\": \"total_bayar\",\n",
        "    \"tip_amount\": \"tip\",\n",
        "    \"nama_pembayaran\": \"metode_bayar\",\n",
        "}\n",
        "df = df.rename(columns=NAMA_BARU)\n",
        "df[\"wilayah_jemput\"] = df[\"wilayah_jemput\"].astype(str)\n",
        "print(\"baris:\", f\"{len(df):,}\", \"| kolom:\", df.shape[1])\n",
        "\n",
        "# Contoh 300.000 baris untuk K-2 dan K-3 (agar tidak terlalu lama)\n",
        "sample = df.sample(n=min(300_000, len(df)), random_state=42).reset_index(drop=True)\n",
        "sample[\"id_perjalanan\"] = sample.index + 1\n",
        "sample[\"waktu_jemput\"] = sample[\"waktu_jemput\"].astype(str)\n",
        "sample.head()"
      ],
