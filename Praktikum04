        "# ====== SEL 0: cek variabel + fungsi bantu (jalankan dulu) ======\n",
        "import random, json, time, os, shutil, glob\n",
        "import numpy as np, pandas as pd\n",
        "\n",
        "perlu = [\"df\",\"sample\",\"data\",\"con\",\"kv\",\"tabel\",\"Q\",\"con_d\",\"G\",\"arus\",\"pohon\",\"bujur\",\"lintang\",\n",
        "         \"cx\",\"cy\",\"PATH_DELTA\",\"data_delta\",\"DIR_SIMPAN\",\"ukur\",\"catatan\"]\n",
        "hilang = [v for v in perlu if v not in globals()]\n",
        "assert not hilang, f\"Variabel ini belum ada: {hilang}. Jalankan K-1 s.d. K-8 dulu, berurutan.\"\n",
        "\n",
        "def ukur_ulang(fungsi, n=5):\n",
        "    \"\"\"Jalankan fungsi n kali, balikin (waktu MEDIAN, hasil terakhir).\n",
        "    Median dipakai supaya satu kali lonjakan waktu (mis. cache belum hangat) tidak merusak angka.\"\"\"\n",
        "    waktu, hasil = [], None\n",
        "    for _ in range(n):\n",
        "        t0 = time.perf_counter()\n",
        "        hasil = fungsi()\n",
        "        waktu.append(time.perf_counter() - t0)\n",
        "    return float(np.median(waktu)), hasil\n",
        "\n",
        "def catat(label, detik):\n",
        "    \"\"\"Simpan ke daftar `catatan` (nanti ikut masuk benchmark_nosql.csv).\"\"\"\n",
