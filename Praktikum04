    {
      "cell_type": "code",
      "source": [
        "from shapely import STRtree, box\n",
        "\n",
        "def uji_sisi(sisi, ulang=3):\n",
        "    h = sisi / 2\n",
        "    kt = [box(x - h, y - h, x + h, y + h) for x, y in zip(cx, cy)]\n",
        "\n",
        "    def pakai_numpy():\n",
        "        out = []\n",
        "        for x, y in zip(cx, cy):\n",
        "            m = (bujur >= x - h) & (bujur <= x + h) & (lintang >= y - h) & (lintang <= y + h)\n",
        "            out.append(int(m.sum()))\n",
        "        return out\n",
        "\n",
        "    def pakai_strtree():\n",
        "        return [len(pohon.query(k, predicate=\"contains\")) for k in kt]\n",
        "\n",
        "    t_np,  h_np  = ukur_ulang(pakai_numpy, ulang)\n",
        "    t_idx, h_idx = ukur_ulang(pakai_strtree, ulang)\n",
        "    return t_np, t_idx, h_np == h_idx, sum(h_idx)\n",
        "\n",
        "t_bangun, _ = ukur_ulang(lambda: STRtree(titik), 3)   # biaya sekali bangun indeks\n",
        "baris = []\n",
        "for sisi in (0.02, 0.01, 0.001):          # 0.01 = ukuran asli K-6, sebagai pembanding\n",
