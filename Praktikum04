        "K-1. Menyiapkan Lingkungan dan Data Contoh\n",
        "\n",
        "Pustaka tambahan untuk praktikum ini (DuckDB, NetworkX, Shapely, TinyDB, deltalake) dipasang lebih\n",
        "dulu. `trips_bersih/` dari Praktikum 3 dicari dalam tiga tingkat: folder Parquet langsung di Drive, lalu\n",
        "`trips_bersih.zip` di Drive (diekstrak otomatis), dan baru data tiruan K-1b sebagai jalur terakhir — supaya\n",
        "notebook aman dijalankan meski sesi Praktikum 3 sebelumnya sudah berakhir."
      ],
      "metadata": {
        "id": "U3DEg0LG3Qxo"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "!pip install -q duckdb networkx shapely tinydb \"deltalake>=1.0\"\n",
        "\n",
        "import os, time, json, sqlite3, random, shutil, glob\n",
        "import numpy as np, pandas as pd\n",
        "\n",
        "try:\n",
        "    from google.colab import drive\n",
        "    DI_COLAB = True\n",
        "    drive.mount(\"/content/drive\")\n",
        "    ROOT = \"/content\"\n",
        "except ImportError:\n",
        "    DI_COLAB = False\n",
        "    ROOT = os.getcwd()\n",
        "    print(\"Bukan runtime Colab -- memakai folder kerja lokal:\", ROOT)\n",
        "\n",
        "DIR_P3 = (os.path.join(ROOT, \"drive/MyDrive/BigData/Praktikum3\") if DI_COLAB\n",
        "          else os.path.join(ROOT, \"BigData_Praktikum3\"))\n",
        "DIR_SIMPAN = (os.path.join(ROOT, \"drive/MyDrive/BigData/Praktikum4\") if DI_COLAB\n",
        "              else os.path.join(ROOT, \"BigData_Praktikum4\"))\n",
        "os.makedirs(DIR_SIMPAN, exist_ok=True)\n",
        "\n",
        "# Pengukur waktu (dari Praktikum 1/K-3, versi ringkas)\n",
        "catatan = []\n",
        "\n",
        "def ukur(label, fungsi):\n",
        "    t0 = time.perf_counter()\n",
        "    hasil = fungsi()\n",
        "    detik = time.perf_counter() - t0\n",
        "    catatan.append({\"langkah\": label, \"detik\": round(detik, 4)})\n",
        "    print(f\"[{label}] {detik:.4f} s\")\n",
        "    return hasil\n",
        "\n",
        "print(\"DIR_P3:\", DIR_P3)\n",
        "print(\"DIR_SIMPAN:\", DIR_SIMPAN)"
      ],
