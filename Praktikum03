        "# ============================================================\n",
        "# LATIHAN 1\n",
        "# Kecepatan download dan pembuktian cache\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import time\n",
        "import requests\n",
        "import shutil\n",
        "\n",
        "def unduh_aman_speed(url, tujuan, percobaan=3, jeda_awal=2):\n",
        "    \"\"\"\n",
        "    Download dengan retry, penulisan atomik,\n",
        "    dan menampilkan kecepatan download MB/detik.\n",
        "    \"\"\"\n",
        "\n",
        "    # Jika file sudah ada, gunakan cache\n",
        "    if os.path.exists(tujuan):\n",
        "        ukuran = os.path.getsize(tujuan) / (1024 ** 2)\n",
        "        print(\"File sudah ada -> menggunakan CACHE\")\n",
        "        print(f\"Ukuran file: {ukuran:.2f} MB\")\n",
        "        return tujuan\n",
        "\n",
        "    sementara = tujuan + \".part\"\n",
        "\n",
        "    for i in range(percobaan):\n",
        "        try:\n",
        "            print(f\"Percobaan ke-{i+1}\")\n",
        "\n",
        "            waktu_mulai = time.perf_counter()\n",
        "\n",
        "            with requests.get(url, stream=True, timeout=60) as r:\n",
        "                r.raise_for_status()\n",
        "\n",
        "                with open(sementara, \"wb\") as f:\n",
        "                    shutil.copyfileobj(r.raw, f)\n",
        "\n",
        "            waktu_selesai = time.perf_counter()\n",
        "\n",
        "            if os.path.getsize(sementara) == 0:\n",
        "                raise IOError(\"Berkas kosong\")\n",
        "\n",
        "            os.replace(sementara, tujuan)\n",
        "\n",
        "            ukuran_mb = os.path.getsize(tujuan) / (1024 ** 2)\n",
        "            waktu = waktu_selesai - waktu_mulai\n",
        "            kecepatan = ukuran_mb / waktu if waktu > 0 else 0\n",
        "\n",
        "            print(f\"Ukuran file      : {ukuran_mb:.2f} MB\")\n",
        "            print(f\"Waktu download   : {waktu:.2f} detik\")\n",
        "            print(f\"Kecepatan        : {kecepatan:.2f} MB/detik\")\n",
        "\n",
        "            return tujuan\n",
        "\n",
        "        except Exception as e:\n",
        "            jeda = jeda_awal * (2 ** i)\n",
        "            print(f\"Percobaan gagal: {e}\")\n",
        "\n",
        "            if i < percobaan - 1:\n",
        "                print(f\"Menunggu {jeda} detik...\")\n",
        "                time.sleep(jeda)\n",
        "\n",
        "    raise RuntimeError(\"Download gagal setelah beberapa percobaan.\")\n",
        "\n",
        "\n",
        "# Definisikan variabel pendukung secara eksplisit jika belum ada di session\n",
        "URL_TRIP = \"https://d37ci6vzurychx.cloudfront.net/trip-data/yellow_tripdata_2023-01.parquet\"\n",
