      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# LATIHAN 4\n",
        "# Membandingkan StandardScaler dan MinMaxScaler\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "from sklearn.preprocessing import StandardScaler, MinMaxScaler\n",
        "\n",
        "# Jaring pengaman jika variabel 'bersih' belum didefinisikan\n",
        "if 'bersih' not in globals():\n",
        "    print(\"Variabel 'bersih' tidak ditemukan. Mempersiapkan data bersih...\")\n",
        "\n",
        "    # Pastikan data trip sudah termuat\n",
        "    if 'trip' not in globals():\n",
        "        PATH_TRIP = \"/content/lapisan_mentah/yellow_tripdata_2023-01.parquet\"\n",
        "        if not os.path.exists(PATH_TRIP):\n",
        "            PATH_TRIP = os.path.join(DIR_SIMPAN, \"latihan1_trip.parquet\")\n",
        "        KOLOM = [\"tpep_pickup_datetime\", \"tpep_dropoff_datetime\", \"passenger_count\",\n",
        "                 \"trip_distance\", \"PULocationID\", \"DOLocationID\", \"payment_type\",\n",
        "                 \"fare_amount\", \"tip_amount\", \"total_amount\"]\n",
        "        trip = pd.read_parquet(PATH_TRIP, columns=KOLOM)\n",
        "\n",
        "    # Lakukan langkah pembersihan minimal untuk mendapatkan fitur yang dibutuhkan\n",
        "    bersih = trip.copy()\n",
        "    bersih[\"durasi_menit\"] = (\n",
        "        (bersih[\"tpep_dropoff_datetime\"] - bersih[\"tpep_pickup_datetime\"])\n",
        "        .dt.total_seconds() / 60\n",
        "    )\n",
        "\n",
        "    # Batasi ke data yang layak (K-8)\n",
        "    layak = (bersih[\"trip_distance\"].between(0.01, 100)\n",
        "             & bersih[\"durasi_menit\"].between(1, 180)\n",
        "             & (bersih[\"total_amount\"] > 0))\n",
        "    bersih = bersih.loc[layak].copy()\n",
        "\n",
        "    # Winsorizing trip_distance\n",
        "    batas_atas = bersih[\"trip_distance\"].quantile(0.995)\n",
        "    bersih[\"trip_distance_capped\"] = bersih[\"trip_distance\"].clip(upper=batas_atas)\n",
        "\n",
        "    # Dapatkan data suhu (suhu_c) secara statis jika API tidak diakses ulang\n",
        "    if 'cuaca' not in globals():\n",
        "        print(\"Menggunakan nilai default untuk fitur suhu_c...\")\n",
        "        bersih[\"suhu_c\"] = 10.0  # Nilai default rata-rata jika data cuaca tidak ada\n",
        "    else:\n",
        "        bersih[\"jam_mulai\"] = bersih[\"tpep_pickup_datetime\"].dt.floor(\"h\")\n",
        "        bersih = bersih.merge(cuaca[[\"jam_mulai\", \"suhu_c\"]], on=\"jam_mulai\", how=\"left\")\n",
        "        # Isi data kosong suhu jika ada\n",
        "        bersih[\"suhu_c\"] = bersih[\"suhu_c\"].fillna(bersih[\"suhu_c\"].median())\n",
        "\n",
        "FITUR_SCALING = [\n",
        "    \"trip_distance_capped\",\n",
        "    \"durasi_menit\",\n",
        "    \"suhu_c\"\n",
        "]\n",
        "\n",
        "data_scaling = bersih.dropna(\n",
        "    subset=FITUR_SCALING\n",
        ").sample(\n",
        "    n=min(10000, len(bersih)),\n",
        "    random_state=42\n",
        ")\n",
        "\n",
        "# StandardScaler\n",
        "standard_scaler = StandardScaler()\n",
        "\n",
        "hasil_standard = standard_scaler.fit_transform(\n",
        "    data_scaling[FITUR_SCALING]\n",
        ")\n",
        "\n",
        "df_standard = pd.DataFrame(\n",
        "    hasil_standard,\n",
        "    columns=FITUR_SCALING\n",
        ")\n",
        "\n",
        "# MinMaxScaler\n",
        "minmax_scaler = MinMaxScaler()\n",
        "\n",
        "hasil_minmax = minmax_scaler.fit_transform(\n",
        "    data_scaling[FITUR_SCALING]\n",
        ")\n",
        "\n",
        "df_minmax = pd.DataFrame(\n",
        "    hasil_minmax,\n",
        "    columns=FITUR_SCALING\n",
        ")\n",
        "\n",
        "print(\"=== StandardScaler ===\")\n",
        "display(df_standard.describe().loc[[\"min\", \"max\", \"mean\", \"std\"]])\n",
        "\n",
        "print(\"\\n=== MinMaxScaler ===\")\n",
        "display(df_minmax.describe().loc[[\"min\", \"max\", \"mean\", \"std\"]])\n",
        "\n",
        "# Simpan hasil\n",
        "perbandingan_scaling = pd.DataFrame({\n",
        "    \"fitur\": FITUR_SCALING,\n",
        "    \"standard_min\": df_standard.min().values,\n",
        "    \"standard_max\": df_standard.max().values,\n",
        "    \"minmax_min\": df_minmax.min().values,\n",
        "    \"minmax_max\": df_minmax.max().values\n",
        "})\n",
        "\n",
        "display(perbandingan_scaling)\n",
        "\n",
        "perbandingan_scaling.to_csv(\n",
        "    os.path.join(DIR_SIMPAN, \"latihan4_scaling.csv\"),\n",
        "    index=False\n",
        ")\n",
        "print(f\"\\nHasil disimpan ke {DIR_SIMPAN}/latihan4_scaling.csv\")"
