      "source": [
        "# ============================================================\n",
        "# PERBANDINGAN HUJAN VS TIDAK HUJAN\n",
        "# ============================================================\n",
        "\n",
        "perbandingan_hujan = (\n",
        "    tabel_analitik\n",
        "    .groupby(\n",
        "        [\"borough_naik\", \"hujan\"],\n",
        "        observed=True\n",
        "    )[\"rata_tarif_per_mil\"]\n",
        "    .median()\n",
        "    .unstack()\n",
        ")\n",
        "\n",
        "print(\"Median tarif per mil:\")\n",
        "display(perbandingan_hujan)\n",
        "\n",
        "# Ubah nama kolom supaya lebih jelas\n",
        "perbandingan_hujan = (\n",
        "    perbandingan_hujan\n",
        "    .rename(\n",
        "        columns={\n",
        "            0: \"tidak_hujan\",\n",
        "            1: \"hujan\"\n",
        "        }\n",
        "    )\n",
        ")\n",
        "\n",
        "# Selisih\n",
        "if \"hujan\" in perbandingan_hujan.columns and \\\n",
        "   \"tidak_hujan\" in perbandingan_hujan.columns:\n",
        "\n",
        "    perbandingan_hujan[\"selisih\"] = (\n",
        "        perbandingan_hujan[\"hujan\"]\n",
        "        - perbandingan_hujan[\"tidak_hujan\"]\n",
        "    )\n",
        "\n",
        "    perbandingan_hujan[\"persentase_perubahan\"] = (\n",
        "        perbandingan_hujan[\"selisih\"]\n",
        "        / perbandingan_hujan[\"tidak_hujan\"]\n",
        "        * 100\n",
        "    )\n",
        "\n",
        "display(perbandingan_hujan)"
      ],
