    },
    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# STUDI KASUS\n",
        "# Tabel analitik pricing\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import pandas as pd\n",
        "\n",
        "# Jaring pengaman jika variabel 'bersih' belum lengkap di session\n",
        "if 'bersih' not in globals() or 'borough_naik' not in globals()['bersih'].columns:\n",
        "    print(\"Kolom 'borough_naik' tidak ditemukan pada DataFrame 'bersih'.\")\n",
        "    print(\"Membangun ulang DataFrame 'bersih' dengan join zona dan fitur tambahan...\")\n",
        "\n",
        "    # 1. Pastikan data trip dasar tersedia\n",
        "    if 'trip' not in globals():\n",
        "        PATH_TRIP = \"/content/lapisan_mentah/yellow_tripdata_2023-01.parquet\"\n",
        "        if not os.path.exists(PATH_TRIP):\n",
        "            PATH_TRIP = os.path.join(DIR_SIMPAN, \"latihan1_trip.parquet\")\n",
        "        KOLOM = [\"tpep_pickup_datetime\", \"tpep_dropoff_datetime\", \"passenger_count\",\n",
        "                 \"trip_distance\", \"PULocationID\", \"DOLocationID\", \"payment_type\",\n",
        "                 \"fare_amount\", \"tip_amount\", \"total_amount\"]\n",
        "        trip = pd.read_parquet(PATH_TRIP, columns=KOLOM)\n",
        "\n",
        "    # 2. Pastikan data zona tersedia\n",
        "    if 'zona' not in globals():\n",
        "        PATH_ZONA = \"/content/lapisan_mentah/taxi_zone_lookup.csv\"\n",
        "        if not os.path.exists(PATH_ZONA):\n",
        "            PATH_ZONA = os.path.join(DIR_SIMPAN, \"taxi_zone_lookup.csv\")\n",
        "        zona = pd.read_csv(PATH_ZONA)\n",
        "\n",
        "    # 3. Rekonstruksi data bersih\n",
        "    trip[\"durasi_menit\"] = ((trip[\"tpep_dropoff_datetime\"] - trip[\"tpep_pickup_datetime\"]).dt.total_seconds() / 60)\n",
        "    layak = (trip[\"trip_distance\"].between(0.01, 100) & trip[\"durasi_menit\"].between(1, 180) & (trip[\"total_amount\"] > 0))\n",
        "    bersih = trip.loc[layak].copy()\n",
        "\n",
        "    # Join zona untuk mendapatkan borough_naik\n",
        "    bersih = bersih.merge(\n",
        "        zona[[\"LocationID\", \"Borough\"]].rename(columns={\"Borough\": \"borough_naik\"}),\n",
        "        left_on=\"PULocationID\", right_on=\"LocationID\",\n",
        "        how=\"left\", validate=\"many_to_one\"\n",
        "    ).drop(columns=\"LocationID\")\n",
        "\n",
        "    # Buat fitur tambahan yang diperlukan oleh studi kasus\n",
        "    bersih[\"kecepatan_mph\"] = (bersih[\"trip_distance\"] / (bersih[\"durasi_menit\"] / 60)).round(2)\n",
        "    bersih[\"tarif_per_mil\"] = (bersih[\"total_amount\"] / bersih[\"trip_distance\"]).round(3)\n",
        "\n",
        "    # Pastikan data cuaca tergabung jika ada, jika tidak gunakan fallback suhu default dan hujan=0\n",
        "    if 'cuaca' in globals():\n",
        "        bersih[\"jam_mulai_cuaca\"] = bersih[\"tpep_pickup_datetime\"].dt.floor(\"h\")\n",
        "        bersih = bersih.merge(cuaca, left_on=\"jam_mulai_cuaca\", right_on=\"jam_mulai\", how=\"left\", suffixes=(\"\", \"_cuaca\"))\n",
        "        bersih[\"hujan\"] = (bersih[\"hujan_mm\"].fillna(0) > 0.1).astype(\"int8\")\n",
        "    else:\n",
        "        bersih[\"suhu_c\"] = 10.0\n",
        "        bersih[\"hujan\"] = 0\n",
        "\n",
        "# Pastikan fitur tersedia\n",
        "bersih_studi = bersih.copy()\n",
        "\n",
        "# Buat jam mulai\n",
        "bersih_studi[\"jam_mulai\"] = (\n",
        "    bersih_studi[\"tpep_pickup_datetime\"]\n",
        "    .dt.floor(\"h\")\n",
        ")\n",
        "\n",
        "# Buat tabel analitik\n",
        "tabel_analitik = (\n",
        "    bersih_studi\n",
        "    .groupby(\n",
        "        [\"borough_naik\", \"jam_mulai\"],\n",
        "        observed=True\n",
        "    )\n",
        "    .agg(\n",
        "        jumlah_perjalanan=(\n",
        "            \"total_amount\",\n",
        "            \"size\"\n",
        "        ),\n",
        "\n",
        "        rata_tarif_per_mil=(\n",
        "            \"tarif_per_mil\",\n",
        "            \"median\"\n",
        "        ),\n",
        "\n",
        "        rata_kecepatan=(\n",
        "            \"kecepatan_mph\",\n",
        "            \"median\"\n",
        "        ),\n",
        "\n",
        "        suhu_c=(\n",
        "            \"suhu_c\",\n",
        "            \"first\"\n",
        "        ),\n",
        "\n",
        "        hujan=(\n",
        "            \"hujan\",\n",
        "            \"max\"\n",
        "        )\n",
        "    )\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# Ambang minimum 30 perjalanan\n",
        "tabel_analitik = tabel_analitik[\n",
        "    tabel_analitik[\"jumlah_perjalanan\"] >= 30\n",
        "].copy()\n",
