      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# INTERPRETASI STUDI KASUS\n",
        "# ============================================================\n",
        "\n",
        "print(\"=== INTERPRETASI PER BOROUGH ===\")\n",
        "\n",
        "for borough, row in perbandingan_hujan.iterrows():\n",
        "\n",
        "    if (\n",
        "        \"hujan\" in row.index\n",
        "        and \"tidak_hujan\" in row.index\n",
        "        and pd.notna(row[\"hujan\"])\n",
        "        and pd.notna(row[\"tidak_hujan\"])\n",
        "    ):\n",
        "\n",
        "        selisih = row[\"hujan\"] - row[\"tidak_hujan\"]\n",
        "        persen = (\n",
        "            selisih\n",
        "            / row[\"tidak_hujan\"]\n",
        "            * 100\n",
        "        )\n",
        "\n",
        "        kondisi = (\n",
        "            \"lebih tinggi\"\n",
        "            if selisih > 0\n",
        "            else \"lebih rendah\"\n",
        "            if selisih < 0\n",
        "            else \"sama\"\n",
        "        )\n",
        "\n",
        "        print(\n",
        "            f\"{borough}: tarif per mil saat hujan \"\n",
        "            f\"{kondisi} dibandingkan tidak hujan \"\n",
        "            f\"sebesar {abs(persen):.2f}%.\"\n",
        "        )"
      ],
