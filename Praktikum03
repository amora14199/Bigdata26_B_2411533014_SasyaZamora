        "print(\"=== PEMANGGILAN PERTAMA ===\")\n",
        "unduh_aman_speed(URL_LATIHAN, PATH_LATIHAN)\n",
        "\n",
        "print(\"\\n=== PEMANGGILAN KEDUA ===\")\n",
        "unduh_aman_speed(URL_LATIHAN, PATH_LATIHAN)"
