        "SQL = \"\"\"\n",
        "    SELECT payment_type, COUNT(*) AS jumlah, AVG(total_amount) AS rata_total\n",
        "    FROM trip_operasional\n",
        "    WHERE total_amount > 0\n",
        "    GROUP BY payment_type\n",
        "    ORDER BY jumlah DESC\n",
        "\"\"\"\n",
