    {
      "cell_type": "code",
      "source": [
        "# ============================================================\n",
        "# LATIHAN 6\n",
        "# Pipeline incremental dan idempotensi\n",
        "# ============================================================\n",
        "\n",
        "import os\n",
        "import time\n",
        "import pandas as pd\n",
        "import requests\n",
        "import shutil\n",
        "\n",
        "# --- JARING PENGAMAN: Inisialisasi variabel & fungsi global jika hilang ---\n",
        "DIR_SIMPAN = globals().get(\"DIR_SIMPAN\", \"/content/drive/MyDrive/BigData/Praktikum3\")\n",
        "DIR_MENTAH = globals().get(\"DIR_MENTAH\", \"/content/lapisan_mentah\")\n",
        "os.makedirs(DIR_MENTAH, exist_ok=True)\n",
        "\n",
        "DIR_INCREMENTAL = os.path.join(\n",
        "    DIR_SIMPAN,\n",
        "    \"latihan6_incremental\"\n",
        ")\n",
        "os.makedirs(DIR_INCREMENTAL, exist_ok=True)\n",
        "\n",
        "KOLOM = globals().get(\"KOLOM\", [\n",
        "    \"tpep_pickup_datetime\", \"tpep_dropoff_datetime\", \"passenger_count\",\n",
        "    \"trip_distance\", \"PULocationID\", \"DOLocationID\", \"payment_type\",\n",
        "    \"fare_amount\", \"tip_amount\", \"total_amount\"\n",
        "])\n",
        "\n",
        "KUNCI = globals().get(\"KUNCI\", [\n",
        "    \"tpep_pickup_datetime\", \"tpep_dropoff_datetime\",\n",
        "    \"PULocationID\", \"DOLocationID\", \"total_amount\"\n",
        "])\n",
        "\n",
        "# Mempersiapkan data zona jika belum ada\n",
        "if 'zona' not in globals():\n",
        "    PATH_ZONA = os.path.join(DIR_MENTAH, \"taxi_zone_lookup.csv\")\n",
        "    if not os.path.exists(PATH_ZONA):\n",
        "        PATH_ZONA = os.path.join(DIR_SIMPAN, \"taxi_zone_lookup.csv\")\n",
        "    if os.path.exists(PATH_ZONA):\n",
        "        zona = pd.read_csv(PATH_ZONA)\n",
        "    else:\n",
        "        zona = pd.read_csv(\"https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv\")\n",
        "\n",
        "# Mempersiapkan tabel tarif_referensi jika belum ada\n",
        "if 'tarif_referensi' not in globals():\n",
        "    tarif_referensi = pd.DataFrame({\n",
        "        \"payment_type\": [1, 2, 3, 4, 5, 6],\n",
        "        \"nama_pembayaran\": [\"Kartu kredit\", \"Tunai\", \"Gratis\",\n",
        "                             \"Sengketa\", \"Tidak diketahui\", \"Perjalanan batal\"]\n",
        "    })\n",
        "\n",
        "# Fungsi unduh_aman cadangan\n",
        "if 'unduh_aman' not in globals():\n",
        "    def unduh_aman(url, tujuan, percobaan=3, jeda_awal=2):\n",
        "        if os.path.exists(tujuan) and os.path.getsize(tujuan) > 0:\n",
        "            return tujuan\n",
        "        sementara = tujuan + \".part\"\n",
        "        for i in range(percobaan):\n",
        "            try:\n",
        "                with requests.get(url, stream=True, timeout=60) as r:\n",
        "                    r.raise_for_status()\n",
        "                    with open(sementara, \"wb\") as f:\n",
        "                        shutil.copyfileobj(r.raw, f)\n",
        "                if os.path.getsize(sementara) == 0:\n",
        "                    raise IOError(\"berkas kosong\")\n",
        "                os.replace(sementara, tujuan)\n",
        "                return tujuan\n",
        "            except Exception as e:\n",
        "                jeda = jeda_awal * (2 ** i)\n",
        "                time.sleep(jeda)\n",
        "        raise RuntimeError(f\"Gagal unduh: {url}\")\n",
        "# ------------------------------------------------------------------------\n",
        "\n",
        "\n",
        "def pipeline_inkremental(bulan):\n",
        "    \"\"\"\n",
        "    Hanya memproses bulan yang belum memiliki\n",
        "    file hasil di direktori output.\n",
        "    \"\"\"\n",
        "\n",
        "    nama_file = f\"trips_bersih_{bulan}.parquet\"\n",
        "    path_output = os.path.join(\n",
        "        DIR_INCREMENTAL,\n",
        "        nama_file\n",
        "    )\n",
        "\n",
        "    # Cek apakah bulan sudah pernah diproses\n",
        "    if os.path.exists(path_output):\n",
        "        print(f\"[SKIP] Bulan {bulan} sudah ada.\")\n",
        "        print(\"       Tidak membuat file baru.\")\n",
        "        return pd.read_parquet(path_output)\n",
        "\n",
        "    # URL sesuai bulan\n",
        "    tahun, nomor_bulan = bulan.split(\"-\")\n",
        "\n",
        "    url = (\n",
        "        \"https://d37ci6vzurychx.cloudfront.net/trip-data/\"\n",
        "        f\"yellow_tripdata_{tahun}-{nomor_bulan}.parquet\"\n",
        "    )\n",
        "\n",
        "    path_mentah = os.path.join(\n",
        "        DIR_MENTAH,\n",
        "        f\"yellow_tripdata_{tahun}-{nomor_bulan}.parquet\"\n",
        "    )\n",
        "\n",
        "    print(f\"[PROSES] Mengambil data {bulan}\")\n",
        "\n",
        "    # Download hanya jika belum ada\n",
        "    unduh_aman(\n",
        "        url,\n",
        "        path_mentah\n",
        "    )\n",
        "\n",
        "    # Baca data\n",
        "    df = pd.read_parquet(\n",
        "        path_mentah,\n",
        "        columns=KOLOM\n",
        "    )\n",
        "\n",
        "    # Pra-pemrosesan dasar sesuai pipeline modul\n",
        "    df[\"durasi_menit\"] = (\n",
        "        (\n",
        "            df[\"tpep_dropoff_datetime\"]\n",
        "            - df[\"tpep_pickup_datetime\"]\n",
        "        ).dt.total_seconds() / 60\n",
        "    )\n",
        "\n",
        "    df[\"jam\"] = df[\n",
        "        \"tpep_pickup_datetime\"\n",
        "    ].dt.hour\n",
        "\n",
        "    df[\"passenger_count\"] = (\n",
        "        df[\"passenger_count\"]\n",
        "        .fillna(\n",
        "            df.groupby(\"jam\")[\n",
        "                \"passenger_count\"\n",
        "            ].transform(\"median\")\n",
        "        )\n",
        "    )\n",
        "\n",
        "    df = df.drop_duplicates(\n",
        "        subset=KUNCI\n",
        "    )\n",
        "\n",
        "    df = df[\n",
        "        df[\"trip_distance\"].between(0.01, 100)\n",
        "        & df[\"durasi_menit\"].between(1, 180)\n",
        "        & (df[\"total_amount\"] > 0)\n",
        "    ]\n",
        "\n",
        "    # Join borough asal\n",
        "    df = df.merge(\n",
        "        zona[[\"LocationID\", \"Borough\"]].rename(\n",
        "            columns={\n",
        "                \"LocationID\": \"PULocationID\",\n",
        "                \"Borough\": \"borough_naik\"\n",
        "            }\n",
        "        ),\n",
        "        on=\"PULocationID\",\n",
        "        how=\"left\",\n",
        "        validate=\"many_to_one\"\n",
        "    )\n",
        "\n",
        "    # Join tarif\n",
        "    df = df.merge(\n",
        "        tarif_referensi[\n",
        "            [\"payment_type\", \"nama_pembayaran\"]\n",
        "        ],\n",
        "        on=\"payment_type\",\n",
        "        how=\"left\",\n",
        "        validate=\"many_to_one\"\n",
        "    )\n",
        "\n",
        "    # Simpan\n",
        "    df.to_parquet(\n",
        "        path_output,\n",
        "        index=False\n",
        "    )\n",
        "\n",
        "    print(\n",
        "        f\"[SELESAI] {bulan}: \"\n",
        "        f\"{len(df):,} baris\"\n",
        "    )\n",
        "    print(\n",
        "        f\"File: {path_output}\"\n",
        "    )\n",
        "\n",
        "    return df\n",
        "\n",
        "\n",
        "# Jalankan pertama kali\n",
        "hasil_incremental_1 = pipeline_inkremental(\"2023-01\")\n",
        "\n",
        "# Hitung file setelah panggilan pertama\n",
        "file_sebelum = set(\n",
        "    os.listdir(DIR_INCREMENTAL)\n",
        ")\n",
        "\n",
        "# Jalankan kedua kali\n",
        "hasil_incremental_2 = pipeline_inkremental(\"2023-01\")\n",
        "\n",
        "# Hitung file setelah panggilan kedua\n",
        "file_sesudah = set(\n",
        "    os.listdir(DIR_INCREMENTAL)\n",
        ")\n",
        "\n",
        "print(\"\\n=== BUKTI IDempotensi ===\")\n",
        "print(\"File sebelum panggilan kedua :\", file_sebelum)\n",
        "print(\"File sesudah panggilan kedua :\", file_sesudah)\n",
        "print(\n",
        "    \"Tidak ada file baru:\",\n",
        "    file_sebelum == file_sesudah\n",
        ")"
      ],
